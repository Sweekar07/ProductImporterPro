# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/product_importer
SYNC_DATABASE_URL=postgresql://postgres:password@db:5432/product_importer

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1

# App
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:5173
UPLOAD_DIR=/tmp/uploads
MAX_UPLOAD_SIZE=524288000

# Environment
ENV=development